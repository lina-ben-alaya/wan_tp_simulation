---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import APPlayer from '../components/ap/APPlayer.tsx';
import SimHost from '../components/sims/SimHost.tsx';
import { TPS } from '../data/index';
import { ACTIVITY_KINDS, SIMS } from '../data/catalog';
import { url } from '../lib/url';
import type { SimId } from '../data/types';

const simOwners = (id: SimId) => TPS.filter((t) => t.sims.includes(id));
---
<BaseLayout title="Simulations" description="Simulations ActivePresenter et simulateurs calculés d’IT LAB.">
  <section class="container page-head">
    <div class="eyebrow">Simulations</div>
    <h1>Simuler sans tromper</h1>
    <p class="lead">Quatre types d’activités, toujours étiquetés. Seuls les labos réels exécutent de vraies commandes.</p>
    <div class="grid-auto" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:16px">
      {Object.values(ACTIVITY_KINDS).map((k) => (
        <div class="card card-pad"><span class="badge badge-kind">{k.label}</span><p class="muted" style="margin:8px 0 0;font-size:0.9rem">{k.description}</p></div>
      ))}
    </div>
  </section>

  <section class="container section-sm" id="activepresenter">
    <h2><Icon name="play" /> Simulations ActivePresenter (HTML5)</h2>
    <p class="muted">Un export par TP, déposé dans <code>public/sims/&lt;slug&gt;/</code>. Tant qu’un export n’est pas déposé, son storyboard est affiché. Ouvrez une ligne pour la lancer.</p>
    <div class="stack">
      {TPS.map((t) => (
        <details class={`card theme-${t.theme}`}>
          <summary class="card-pad" style="cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <span class="badge badge-theme">{t.code}</span><strong>{t.title}</strong><span class="dim" style="margin-left:auto;font-size:0.84rem">{t.ap.scenes.length} scènes</span>
          </summary>
          <div style="padding:0 20px 20px">
            <APPlayer client:load slug={t.slug} title={`${t.code} – ${t.title}`} src={url(t.ap.file)} scenes={t.ap.scenes} author={t.ap.author} />
          </div>
        </details>
      ))}
      <details class="card">
        <summary class="card-pad" style="cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <span class="badge badge-warn">TEST</span><strong>Vérifier l’intégration (gabarit de test, pas un export ActivePresenter)</strong>
        </summary>
        <div style="padding:0 20px 20px">
          <p class="muted">Ce gabarit reproduit uniquement l’envoi du score qu’un export ActivePresenter doit faire sur sa dernière diapositive. Il sert à vérifier le pont avant de déposer les vrais exports.</p>
          <APPlayer client:load slug="demo" title="Gabarit de test du pont" src={url('sims/_demo/index.html?tp=demo')} scenes={['Diapositive 1', 'Question', 'Feedback', 'Résultat', 'Envoi du score']} />
        </div>
      </details>
    </div>
  </section>

  <section class="container section-sm" id="calcules">
    <h2><Icon name="flask" /> Simulateurs calculés</h2>
    <p class="muted">Des modèles JavaScript appliquent les règles enseignées (choix de route, import RT, traduction NAT…). Ce ne sont pas des émulateurs Cisco IOS.</p>
    <div class="stack">
      {(Object.keys(SIMS) as SimId[]).map((id) => (
        <details class="card" id={`sim-${id}`}>
          <summary class="card-pad" style="cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <span class="badge badge-kind">CALCULÉ</span><strong>{SIMS[id].title}</strong>
            <span class="dim" style="font-size:0.84rem">{SIMS[id].description}</span>
            <span style="margin-left:auto;display:flex;gap:6px">{simOwners(id).map((t) => <span class="badge">{t.code}</span>)}</span>
          </summary>
          <div style="padding:0 20px 20px"><SimHost client:visible id={id} /></div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
