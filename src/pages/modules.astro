---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { TpCard } from '../components/library/LibraryGrid.tsx';
import { TPS } from '../data/index';
import { SUBJECTS, THEMES } from '../data/catalog';
import { toCard } from '../lib/cards';
import { url } from '../lib/url';
import type { SubjectId, ThemeId } from '../data/types';

const subjects = Object.keys(SUBJECTS) as SubjectId[];
---
<BaseLayout title="Modules" description="Les TP classés par matière et par thème.">
  <section class="container page-head">
    <div class="eyebrow">Modules</div>
    <h1>Classement par matière</h1>
    <p class="lead">Chaque matière regroupe ses thèmes ; chaque thème, ses TP. Les matières ne sont pas mélangées.</p>
  </section>
  {subjects.map((s) => {
    const themes = [...new Set(TPS.filter((t) => t.subject === s).map((t) => t.theme))] as ThemeId[];
    return (
      <section class="container section-sm">
        <div class="card card-pad" style="margin-bottom:16px">
          <div class="eyebrow"><Icon name="book" size={14} /> Matière</div>
          <h2 style="margin-bottom:4px">{SUBJECTS[s].label}</h2>
          <p class="muted" style="margin:0">{SUBJECTS[s].description}</p>
        </div>
        {themes.map((th) => (
          <div id={th} class={`anchor-offset theme-${th}`} style="margin:22px 0">
            <h3 style="display:flex;align-items:center;gap:10px"><span class="badge badge-theme">{THEMES[th].label}</span><span class="muted" style="font-weight:400;font-size:0.95rem">{THEMES[th].description}</span></h3>
            <div class="grid-auto">
              {TPS.filter((t) => t.subject === s && t.theme === th).map((t) => <TpCard tp={toCard(t)} href={url(`tps/${t.slug}`)} completion={0} />)}
            </div>
          </div>
        ))}
      </section>
    );
  })}
  <section class="container">
    <p class="dim" style="font-size:0.88rem">Le TP BGP (document Cisco Networking Academy sans en-tête de module) est classé par défaut en Routage &amp; Commutation.</p>
  </section>
</BaseLayout>
