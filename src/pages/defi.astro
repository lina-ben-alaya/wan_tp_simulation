---
import BaseLayout from '../layouts/BaseLayout.astro';
import Challenge from '../components/challenge/Challenge.tsx';
import { TPS } from '../data/index';
import { url } from '../lib/url';

const cases = TPS.flatMap((t) => t.compare.map((c) => ({ ...c, tpTitle: t.title, tpSlug: t.slug })));
---
<BaseLayout title="Mode défi" description="Dépannage chronométré à partir des erreurs classiques des TP.">
  <section class="container page-head">
    <div class="eyebrow">Mode défi</div>
    <h1>Dépannage chronométré</h1>
    <p class="lead">Un symptôme réel issu des TP, quatre corrections possibles, {45} secondes. Chaque panne correspond à une erreur décrite dans les énoncés.</p>
  </section>
  <section class="container">
    <Challenge client:load cases={cases} base={url()} />
  </section>
</BaseLayout>
