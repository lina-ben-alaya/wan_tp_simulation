---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dashboard from '../components/dashboard/Dashboard.tsx';
import { TPS } from '../data/index';
import { url } from '../lib/url';

const tps = TPS.map((t) => ({ slug: t.slug, title: t.title, code: t.code, theme: t.theme, tags: Object.fromEntries(t.quiz.map((q) => [q.id, q.tags])) }));
---
<BaseLayout title="Dashboard" description="Progression, résultats et points faibles.">
  <section class="container page-head">
    <div class="eyebrow">Dashboard</div>
    <h1>Votre progression</h1>
    <p class="lead">Calculée à partir de vos activités réelles : modes terminés, scores de pratique et d’évaluation, défis, simulations.</p>
  </section>
  <section class="container">
    <Dashboard client:load tps={tps} base={url()} />
  </section>
</BaseLayout>
