---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { TPS, getTp } from '../../data/index';
import { THEMES } from '../../data/catalog';
import { apAvailable } from '../../lib/ap-status';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return TPS.map((t) => ({ params: { slug: t.slug } }));
}
const tp = getTp(Astro.params.slug!)!;
const ok = apAvailable(tp);
const src = url(tp.ap.file);
const idx = TPS.findIndex((t) => t.slug === tp.slug);
const prev = TPS[idx - 1];
const next = TPS[idx + 1];
---
<BaseLayout title={tp.title} description={tp.summary}>
  <div class={`theme-${tp.theme}`}>
    <section class="container page-head" style="padding-bottom:16px">
      <nav aria-label="Fil d’Ariane" class="dim" style="font-size:0.86rem;margin-bottom:12px">
        <a href={url('tps')}>Simulations</a> / <span>{tp.code}</span>
      </nav>
      <span class="badge badge-theme">{THEMES[tp.theme].label}</span>
      <h1 style="margin:10px 0 6px">{tp.title}</h1>
      <p class="lead" style="margin:0">{tp.subtitle}</p>
    </section>

    <section class="container">
      {ok ? (
        <>
          <div id="ap-box" style="position:relative;background:#000;border-radius:14px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-lg)">
            <iframe id="ap-frame" src={src} title={`Simulation ActivePresenter – ${tp.title}`} allow="fullscreen; autoplay" allowfullscreen
              style="display:block;width:100%;height:min(78vh, 56.25vw);min-height:360px;border:0"></iframe>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
            <button class="btn btn-primary btn-sm" type="button" id="ap-fullscreen"><Icon name="expand" /> Plein écran</button>
            <button class="btn btn-ghost btn-sm" type="button" id="ap-restart"><Icon name="restart" /> Recommencer</button>
            <a class="btn btn-quiet btn-sm" href={src} target="_blank" rel="noopener">Ouvrir dans un onglet <Icon name="external" /></a>
          </div>
        </>
      ) : (
        <div class="card card-pad" style="text-align:center;padding:48px 24px">
          <span style="color:var(--primary)"><Icon name="clock" size={40} /></span>
          <h2 style="margin-top:12px">Simulation à venir</h2>
          <p class="muted" style="margin:0 auto;max-width:520px">La simulation ActivePresenter de ce TP est en cours de réalisation.</p>
        </div>
      )}

      <nav style="display:flex;justify-content:space-between;gap:12px;margin-top:28px;flex-wrap:wrap" aria-label="TP précédent et suivant">
        {prev ? <a class="btn btn-ghost" href={url(`tps/${prev.slug}`)}><Icon name="prev" /> {prev.title}</a> : <span />}
        {next && <a class="btn btn-ghost" href={url(`tps/${next.slug}`)}>{next.title} <Icon name="next" /></a>}
      </nav>
    </section>
  </div>
  <script>
    const box = document.getElementById('ap-box');
    const frame = document.getElementById('ap-frame') as HTMLIFrameElement | null;
    document.getElementById('ap-fullscreen')?.addEventListener('click', () => box?.requestFullscreen?.().catch(() => undefined));
    document.getElementById('ap-restart')?.addEventListener('click', () => { if (frame) frame.src = frame.src; });
  </script>
</BaseLayout>
