---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { AUTHOR } from '../data/catalog';
import { url } from '../lib/url';
---
<BaseLayout title="À propos" description="Le projet IT LAB : simulations ActivePresenter des TP réseaux.">
  <section class="container page-head">
    <div class="eyebrow">À propos</div>
    <h1>Le projet IT LAB</h1>
    <p class="lead">Une plateforme qui rassemble les simulations ActivePresenter des travaux pratiques de réseaux informatiques (RSI3).</p>
  </section>
  <section class="container section-sm prose" style="max-width:900px">
    <div class="card card-pad" style="display:flex;gap:14px;align-items:center">
      <span style="color:var(--primary)"><Icon name="user" size={28} /></span>
      <div><div class="eyebrow" style="margin-bottom:2px">Conception et réalisation</div><strong style="font-size:1.2rem;color:var(--text)">{AUTHOR}</strong></div>
    </div>
    <h2>Contenu</h2>
    <p>Backbone MPLS, VPN MPLS, BGP, redistribution OSPF/EIGRP/RIPv2, NAT/PAT/DHCP, VPN IPsec, tunnel GRE over IPsec et Frame Relay.</p>
    <h2>Les simulations</h2>
    <p>Chaque simulation est réalisée avec ActivePresenter puis exportée en HTML5 : elle s’ouvre directement dans le navigateur, sans installation. Les commandes saisies sont comparées aux réponses attendues ; aucun équipement réseau réel n’est exécuté.</p>
    <p><a class="btn btn-primary" href={url('tps')}>Voir les simulations <Icon name="arrowRight" /></a></p>
  </section>
</BaseLayout>
