---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import TpGrid from '../components/TpGrid.astro';
import { TPS } from '../data/index';
import { AUTHOR } from '../data/catalog';
import { apAvailable } from '../lib/ap-status';

const available = TPS.filter(apAvailable).length;
---
<BaseLayout title="IT LAB">
  <section class="container section" style="padding-bottom:28px">
    <div class="eyebrow"><Icon name="play" size={14} /> Simulations ActivePresenter · RSI3 · par {AUTHOR}</div>
    <h1>Les TP réseaux,<br /><span style="color:var(--primary)">en simulation.</span></h1>
    <p class="lead">
      Chaque travail pratique est rejoué dans une simulation interactive réalisée avec ActivePresenter :
      manipulations guidées, saisie des commandes, captures et questions.
    </p>
    <div style="display:flex;gap:28px;flex-wrap:wrap;margin-top:20px">
      <div class="stat"><b>{TPS.length}</b><span>TP</span></div>
      <div class="stat"><b>{available}</b><span>simulation{available > 1 ? 's' : ''} disponible{available > 1 ? 's' : ''}</span></div>
    </div>
  </section>
  <section class="container" id="simulations">
    <TpGrid />
  </section>
</BaseLayout>
